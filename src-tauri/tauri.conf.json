{
  "$schema": "https://raw.githubusercontent.com/nicotaurix/tauri/v2/core/tauri-config-schema/schema.json",
  "productName": "NicoTauriX",
  "version": "0.1.0",
  "identifier": "com.nicotaurix.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NicoTauriX - ニコニコXブラウザ",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
